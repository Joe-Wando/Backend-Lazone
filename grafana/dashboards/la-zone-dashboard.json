{
  "uid": "la-zone-monitoring",
  "title": "La Zone - Monitoring",
  "tags": ["la-zone"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Réservations créées (total)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-la-zone" },
      "targets": [
        { "expr": "reservations_total", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Paiements par statut",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-la-zone" },
      "targets": [
        { "expr": "paiements_total", "legendFormat": "{{statut}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Durée des requêtes HTTP (p95 par route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-la-zone" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Erreurs HTTP par code de statut",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-la-zone" },
      "targets": [
        {
          "expr": "sum by (status_code) (http_errors_total)",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    }
  ]
}

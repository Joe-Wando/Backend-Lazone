      "Bash(curl -s http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code} sur /showtimes \\(port 3000\\)\\\\n\" http://localhost:3000/showtimes)",
      "Bash(powershell -Command \"Stop-Process -Id 17640 -Force\")",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3000/showtimes)",
      "Bash(powershell -Command \"Stop-Process -Id 2576 -Force\")",
      "Bash(git push *)"
    ]
  }
